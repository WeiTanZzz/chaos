{
    "name": "projects",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --parallel --no-orphans --filter './apps/*' dev",
        "dev:api": "bun run --filter @chaos/api dev",
        "dev:web": "bun run --filter @chaos/web dev",
        "start": "bun run --parallel --no-orphans --filter './apps/*' start",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check --write .",
        "ci": "biome ci .",
        "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
        "test": "bun test",
        "db:generate": "bun run --filter @chaos/api db:generate",
        "db:migrate": "bun run --filter @chaos/api db:migrate",
        "db:studio": "bun run --filter @chaos/api db:studio"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@types/bun": "^1.4.0",
        "typescript": "5.9.3"
    }
}
